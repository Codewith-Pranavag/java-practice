class Solution {
    public int waysToSplitArray(int[] nums) {
        long sum=0;
        for(int num:nums){
            sum+=num;
        }
        long valid=0;
        long sumlast=sum;
        long currsum=0;
        for(int i=0;i<nums.length-1;i++){
            currsum+=nums[i];
            sum-=nums[i];
            if(currsum>=sum) valid++;
        }
        return (int)valid;
    }
}
